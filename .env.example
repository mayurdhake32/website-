# Copy this file to .env for local testing only.
# On Render, you will NOT upload this file — you'll type these into the
# Render dashboard's "Environment" tab instead.

# Airtable Personal Access Token (create a NEW one — the old one is compromised)
AIRTABLE_API_KEY=your_new_airtable_token_here

# Found in your Airtable base URL: airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appLSZSUHkyFCNPhs

# The table name that holds your blog posts
AIRTABLE_TABLE_NAME=Blogs

# NEW admin password for the "Manage Blogs" panel (do not reuse the old one)
ADMIN_PASSWORD=choose_a_new_strong_password

# A long random secret used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Your live Vercel frontend URL (no trailing slash). Comma-separate if you have more than one.
FRONTEND_URL=https://your-site.vercel.app

# Render sets this automatically; you can leave it as-is
PORT=10000
